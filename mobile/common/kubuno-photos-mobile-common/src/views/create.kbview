<?xml version="1.0" encoding="utf-8"?>
<!--
  Photos · Create - the Create tab (CreateTabContent) from PhotosApp.kt. The "Créer" title and three
  CreateAction rows (accent-tinted round icon + title + subtitle), with the floating bottom NavPill
  (Créer active). Light theme, logical px (~390 wide). Screen root is a Panel.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       Layout="Dock" BackColor="#FFFFFF">

  <Stack Dock="Top">
    <Label Text="Créer" Role="Title" FontWeight="SemiBold" ForeColor="#202124" Padding="16, 16, 16, 8"/>
  </Stack>

  <!-- Floating bottom nav pill + detached round search button (Créer active) -->
  <Stack Dock="Bottom" CrossAlign="Center" Padding="0, 6, 0, 12">
    <Stack Direction="LeftToRight" CrossAlign="Center" Gap="10">
      <Stack Direction="LeftToRight" CrossAlign="Center" Gap="4" BackColor="#FFFFFF" CornerRadius="9999"
             Elevation="Lg" Padding="8, 6, 8, 6">
        <Stack CrossAlign="Center" Justify="Center" Padding="14, 8, 14, 8">
          <Icon Name="Images" Size="22" ForeColor="#5F6368"/>
        </Stack>
        <Stack CrossAlign="Center" Justify="Center" Padding="14, 8, 14, 8">
          <Icon Name="Layers" Size="22" ForeColor="#5F6368"/>
        </Stack>
        <Stack Direction="LeftToRight" CrossAlign="Center" Gap="6" BackColor="#E8F0FE" CornerRadius="9999"
               Padding="14, 8, 14, 8">
          <Icon Name="CirclePlus" Size="22" ForeColor="#1A73E8"/>
          <Label Text="Créer" Role="Caption" FontWeight="SemiBold" ForeColor="#1A73E8"/>
        </Stack>
      </Stack>
      <Stack CrossAlign="Center" Justify="Center" BackColor="#FFFFFF" CornerRadius="9999" Elevation="Lg"
             Width="52" Height="52">
        <Icon Name="Search" Size="22" ForeColor="#202124"/>
      </Stack>
    </Stack>
  </Stack>

  <ScrollArea Dock="Fill">
    <Stack Gap="0" Padding="0, 4, 0, 12">

      <Stack Direction="LeftToRight" CrossAlign="Center" Gap="16" Padding="16, 14, 16, 14">
        <Stack CrossAlign="Center" Justify="Center" BackColor="#E8F0FE" CornerRadius="9999" Width="48" Height="48">
          <Icon Name="Camera" Size="24" ForeColor="#1A73E8"/>
        </Stack>
        <Stack Stack.Fill="true" Gap="2">
          <Label Text="Prendre une photo" Role="Body" ForeColor="#202124"/>
          <Label Text="Capturer et ajouter à la photothèque" Role="Meta" ForeColor="#5F6368"/>
        </Stack>
      </Stack>

      <Stack Direction="LeftToRight" CrossAlign="Center" Gap="16" Padding="16, 14, 16, 14">
        <Stack CrossAlign="Center" Justify="Center" BackColor="#E8F0FE" CornerRadius="9999" Width="48" Height="48">
          <Icon Name="Video" Size="24" ForeColor="#1A73E8"/>
        </Stack>
        <Stack Stack.Fill="true" Gap="2">
          <Label Text="Filmer une vidéo" Role="Body" ForeColor="#202124"/>
          <Label Text="Enregistrer et ajouter à la photothèque" Role="Meta" ForeColor="#5F6368"/>
        </Stack>
      </Stack>

      <Stack Direction="LeftToRight" CrossAlign="Center" Gap="16" Padding="16, 14, 16, 14">
        <Stack CrossAlign="Center" Justify="Center" BackColor="#E8F0FE" CornerRadius="9999" Width="48" Height="48">
          <Icon Name="ImagePlus" Size="24" ForeColor="#1A73E8"/>
        </Stack>
        <Stack Stack.Fill="true" Gap="2">
          <Label Text="Importer depuis l'appareil" Role="Body" ForeColor="#202124"/>
          <Label Text="Choisir des photos ou vidéos existantes" Role="Meta" ForeColor="#5F6368"/>
        </Stack>
      </Stack>

    </Stack>
  </ScrollArea>


</Panel>
